<Window x:Class="morse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:morse"
        mc:Ignorable="d"
        Title="Morse" Height="450" Width="750" MinHeight="450" MinWidth="600" WindowStyle="SingleBorderWindow">
    <Grid>
        <Grid Background="Black" Height="100" Margin="0,0,0,0" VerticalAlignment="Top">
			<TextBlock FontSize="16" Foreground="White" Margin="30,20,0,0"><Run Text="Digite o texto para ser convertido em morse"/></TextBlock>
			<TextBox Name="texto" HorizontalAlignment="Left" Height="23" Margin="32,47,0,0" TextWrapping="Wrap"  Text="" VerticalAlignment="Top" Width="320" TextChanged="texto_TextChanged"/>
            <Button Content="Enviar" HorizontalAlignment="Left" Margin="361,47,0,0" VerticalAlignment="Top" Width="75" Height="23" RenderTransformOrigin="-1.52,0.6" Click="Button_Click"/>
            <Button Content="Copiar" HorizontalAlignment="Left" Margin="440,47,0,0" VerticalAlignment="Top" Width="75" Height="23" RenderTransformOrigin="-1.52,0.6" Click="Button_Click_1" />
            <TextBlock Name="notificationText" Foreground="White" HorizontalAlignment="Left" Margin="33,75,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock FontSize="24" TextWrapping="Wrap" Name="morseTexto" Text="" Margin="20,120,20,20"/>
    </Grid>
</Window>
